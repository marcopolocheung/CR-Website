# Copy to .env.agent at the repository root. Do not commit this file with secrets.
AGENT_HOST=127.0.0.1
AGENT_PORT=8790
AGENT_ALLOWED_ORIGIN=http://localhost:3000
AGENT_DB_PATH=.agent-data/scheduling.sqlite
# Use the same manager code as the schedule Worker; at least 16 characters.
AGENT_MANAGER_TOKEN=
# Local by default. No production fallback.
AGENT_SCHEDULE_API=http://127.0.0.1:8787
# Both are optional. Without them the bounded scheduling workflow still works.
ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=
