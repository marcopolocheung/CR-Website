  "scenarios": [
    {
      "scenario": "cancel cash context transition",
      "observed": "Canceling draft change retains exact store/date, count and cashier; no replacement occurs"
    },
    {
      "scenario": "shared access and retained work",
      "observed": "One verified unlock crosses all internal tools using pointer and keyboard; exact CR2 cash/CR3 form contexts and values plus original import File survive without document reload or departure prompt"
    },
    {
      "scenario": "history",
      "observed": "Back/Forward changes visible workspace while retaining entered narrative and task context"
    },
    {
      "scenario": "incomplete import handoff",
      "observed": "Shared manual lock refuses memory-only incomplete import work without claiming a durable copy; exact File and entered dates remain available for completing or exporting work"
    },
    {
      "scenario": "manual lock refuses failed storage",
      "observed": "Denied device writes in a visited form block shared manual lock and retain both form/cash values and manager access; internal navigation remains available"
    },
    {
      "scenario": "manual lock saves and leaves",
      "observed": "Successful shared lock returns cash to draft choice and Forms to list; both explicit resumes recover the exact separately labelled drafts; tokens absent from device storage"
    },
    {
      "scenario": "authorization expiry and explicit retry",
      "observed": "A 401 clears shared access immediately despite denied storage, hides protected work in every tool, retains the original draft, and requires an explicit retry after unlock"
    },
    {
      "scenario": "active-only print",
      "observed": "Printed cash includes cashier and $300 while retained inactive Forms/Inventory and shell controls stay out of output"
    },
    {
      "scenario": "language and enlarged layout",
      "observed": "EN/ES switch retains cash inputs and exact context at 320px with 200% text; headless touch remains distinct from physical keyboard/device evidence"
    },
    {
      "scenario": "fresh-session boundary",
      "observed": "Reload requires authentication again; labelled device drafts and remembered preparer never confer access"
    },
    {
      "scenario": "inventory context and catalog recovery",
      "observed": "Cancel retains exact date/raw 3B/2T count; confirmed date change preserves its exact-day copy; locking from Dashboard checkpoints catalog name/base revision, unlock returns to counting, explicit resume retains original revision and detects newer server baseline"
    },
    {
      "scenario": "import forbidden expiry",
      "observed": "A 403 import-history response clears shared access through the import error adapter while retaining selected store/date; a new verified unlock restores access without an automatic write"
    },
    {
      "scenario": "late response generation",
      "observed": "A held cash write acknowledged after another tool expires access and the same code reauthenticates cannot mark the current draft server-saved, revoke the new session or replay the write"
    },
    {
      "scenario": "scheduler boundary",
      "observed": "Internal shared unlock does not grant the separate scheduler gate; public/crew permission adapters remain independent"
    }
  ],
