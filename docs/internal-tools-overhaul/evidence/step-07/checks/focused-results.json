    },
    {
      "scenario": "keyboard and keypad continuity",
      "observed": "Native Enter moves through visible name/Count/Amount inputs without submitting; optional keypad Next crosses AM\u2192PM, selects the corresponding drawer and Escape returns exact field focus"
    },
    {
      "scenario": "offline authorization and failed storage recovery",
      "observed": "Forced 401 hides protected focused workspace despite denied storage; unlock restores same drawer, name and count; offline save retains input and explicit retry succeeds"
    },
    {
      "scenario": "English paper from Spanish focused UI",
      "observed": "Spanish language switch preserves active drawer; printed paper retains all AM/PM drawer names, full denominations and money while focused controls/shell/keypad stay off paper"
    },
    {
      "scenario": "late save and drawer switch",
      "observed": "A delayed save retains its submitted three-count snapshot while a later four-count edit and drawer switch survive; current work is not mislabeled server-saved"
    },
    {
      "scenario": "reload and explicit resume",
      "observed": "Reload clears memory access; explicit labelled resume restores name, actual zero count, Amount-derived count two and still-blank denominations without treating remembered preparer as authentication"
    },
    {
      "scenario": "responsive language and short viewport",
      "observed": "English/Spanish focused workspace retains entry at 768/375/320px and 200% text; keypad buttons meet 44px, Close/Save remain reachable and a panned keyboard-sized VisualViewport leaves space for the focused count below the half-height summary; reduced motion removes shell slide"
