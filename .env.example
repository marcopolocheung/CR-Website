# GA4 measurement ID, e.g. G-XXXXXXXXXX. Copy this file to .env.local to send
# local traffic to a property; leave it unset and the site loads no analytics.
NEXT_PUBLIC_GA_ID=

# Only a GitHub project-pages deploy needs a base path. Leave empty for the
# custom domain (chinarosesa.com) — a wrong value rewrites every asset URL.
NEXT_PUBLIC_BASE_PATH=

# Public base URL of the schedule store Worker (no secret — the golden
# schedule reads are public; writes need the manager token typed into the
# demo). Defaults to the production Worker when unset.
NEXT_PUBLIC_SCHEDULE_API=https://chinarose-schedule-api.crbrucecheung.workers.dev
