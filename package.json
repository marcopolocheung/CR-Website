{
  "name": "chinarose",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/mirror-trailing-slash.mjs",
    "start": "next start",
    "scheduler:test": "node --import jiti/register --test src/lib/scheduler/scheduler.test.ts src/lib/scheduler/week-visibility.test.ts src/lib/scheduler/editor-state.test.ts src/components/scheduler/helpers.test.ts src/lib/schedule-share.test.ts src/lib/schedule-store.test.ts worker/src/index.test.ts",
    "scheduler:verify": "node scripts/verify-schedule-store.mjs",
    "scheduler:seed-kitchens": "node scripts/seed-kitchen-stations.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "cashout:test": "node --import jiti/register --test src/lib/cashout.test.ts src/lib/dashboard.test.ts src/lib/inventory.test.ts src/lib/internal-tools/cashout-draft.test.ts",
    "data:test": "node --test worker/local-data.test.mjs worker/src/record-mutations.test.mjs",
    "data:migrate:local": "wrangler d1 migrations apply chinarose-internal-local --local --config worker/wrangler.local.jsonc",
    "worker:dev:local": "wrangler dev --local --config worker/wrangler.local.jsonc",
    "worker:types:local": "wrangler types worker/local-env.d.ts --config worker/wrangler.local.jsonc --env-interface LocalBindings --include-runtime false",
    "recovery:test": "node --import jiti/register --test src/lib/internal-tools/recovery.test.ts",
    "imports:test": "node --import jiti/register --test src/lib/converter/validation.test.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "exceljs": "4.4.0",
    "next": "^16.1.6",
    "papaparse": "5.5.3",
    "postcss": "^8.5.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260426.1",
    "wrangler": "4.86.0"
  }
}
