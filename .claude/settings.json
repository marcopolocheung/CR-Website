{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:full)",
      "Bash(npm run -s check)",
      "Bash(npm run -s check:full)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run *:test)",
      "Bash(python3 scripts/check-overhaul-tracker.py)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch -c feat/*)",
      "Bash(git switch -c chore/*)",
      "Bash(git switch -c claude/*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)"
    ],
    "deny": [
      "Read(./.env.agent)",
      "Read(./worker/.dev.vars)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler * --remote*)",
      "Bash(npx wrangler * --remote*)",
      "Bash(wrangler secret *)",
      "Bash(npx wrangler secret *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.sh\" --record-base"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.sh\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
